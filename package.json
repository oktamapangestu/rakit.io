{
  "name": "rakit-icu",
  "version": "0.1.0",
  "private": true,
  "description": "Editor kode online ala VS Code dengan hosting HTML/CSS/JS di *.rakit.io",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "build": "bash build-assets.sh"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
