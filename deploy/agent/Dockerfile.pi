# Image mesin agen Pi: Pi + Chromium headless untuk cek-halaman.
# Dipakai mode Agen di editor (go/internal/ai/agent.go) dan evaluasi (scripts/ai-eval/sandbox-engines.mjs).
# Dibangun dengan deploy/agent/build.sh (juga otomatis oleh `npm run ai:eval -- --engine pi`); versi dikunci.
# Konteks build: deploy/agent (docker build -f Dockerfile.pi).
FROM node:24.11.1-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates curl git ripgrep \
 && npm install -g --ignore-scripts @earendil-works/pi-coding-agent@1.0.0 playwright@1.56.1 \
 && playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/* /root/.npm

ENV NODE_PATH=/usr/local/lib/node_modules PI_SKIP_VERSION_CHECK=1 PI_TELEMETRY=0 PI_OFFLINE=1
COPY rakit-extension.ts cek-halaman.cjs proxy.cjs entrypoint.sh /opt/rakit/
RUN chmod +x /opt/rakit/cek-halaman.cjs /opt/rakit/entrypoint.sh \
 && ln -s /opt/rakit/cek-halaman.cjs /usr/local/bin/cek-halaman
WORKDIR /workspace
ENTRYPOINT ["/opt/rakit/entrypoint.sh"]
