# Image mesin agen Claude Agent SDK: SDK + Chromium headless untuk cek-halaman.
# Dipakai mode Agen di editor (go/internal/ai/agent.go) dan evaluasi (scripts/ai-eval/sandbox-engines.mjs).
# Dibangun dengan deploy/agent/build.sh (juga otomatis oleh `npm run ai:eval -- --engine claude`); versi dikunci.
# Konteks build: deploy/agent (docker build -f Dockerfile.claude).
FROM node:24.11.1-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates curl git ripgrep \
 && npm install -g --ignore-scripts playwright@1.56.1 \
 && playwright install --with-deps chromium \
 && mkdir -p /opt/rakit && cd /opt/rakit && npm init -y >/dev/null \
 && npm install --ignore-scripts @anthropic-ai/claude-agent-sdk@0.3.286 @anthropic-ai/sdk@0.131.0 \
      @modelcontextprotocol/sdk@1.31.0 zod@4.6.5 \
 && rm -rf /var/lib/apt/lists/* /root/.npm

ENV NODE_PATH=/usr/local/lib/node_modules IS_SANDBOX=1 DISABLE_AUTOUPDATER=1 DISABLE_TELEMETRY=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
COPY claude_driver.mjs cek-halaman.cjs proxy.cjs entrypoint.sh /opt/rakit/
RUN chmod +x /opt/rakit/cek-halaman.cjs /opt/rakit/entrypoint.sh \
 && ln -s /opt/rakit/cek-halaman.cjs /usr/local/bin/cek-halaman
WORKDIR /workspace
ENTRYPOINT ["/opt/rakit/entrypoint.sh"]
