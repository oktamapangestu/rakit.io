# Unit systemd untuk rakit.io — salin ke /etc/systemd/system/rakit.service
#
#   sudo cp deploy/rakit.service /etc/systemd/system/rakit.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rakit.service
#
# Catatan: app hanya mendengarkan di 127.0.0.1 (lihat HOST/PORT di .env) dan
# diakses publik lewat Nginx reverse proxy (lihat deploy/nginx-rakit.conf).
[Unit]
Description=rakit.io - editor kode online
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/rakit
ExecStart=/usr/local/bin/node --env-file-if-exists=/srv/rakit/.env /srv/rakit/src/server.js
Restart=always
RestartSec=5
User=root
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
