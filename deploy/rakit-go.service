# Unit systemd untuk server Go rakit.io — salin ke /etc/systemd/system/rakit-go.service
#
#   sudo cp deploy/rakit-go.service /etc/systemd/system/rakit-go.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rakit-go.service
#
# Server ini menangani semuanya sendiri (aplikasi, website project, AI, pembayaran, dashboard owner) dan
# membuat skema database saat menyala. Nginx diarahkan ke port 3011 (deploy/nginx-rakit.conf).
# PORT di bawah menimpa PORT di .env. Server Node lama (rakit.service) tidak perlu menyala.
[Unit]
Description=rakit.io - editor kode online (Go)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/rakit
ExecStart=/srv/rakit/go/bin/rakit --env-file /srv/rakit/.env
Restart=always
RestartSec=5
User=root
Environment=HOST=127.0.0.1
Environment=PORT=3011

[Install]
WantedBy=multi-user.target
