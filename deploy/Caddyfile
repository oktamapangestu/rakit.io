# Caddy dengan sertifikat wildcard *.rakit.icu (butuh DNS challenge).
# Build Caddy dengan plugin DNS provider, contoh Cloudflare:
#   xcaddy build --with github.com/caddy-dns/cloudflare
# Lalu set env CF_API_TOKEN (token dengan izin Zone.DNS:Edit).

rakit.icu, *.rakit.icu {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}
