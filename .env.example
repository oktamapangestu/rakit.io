# Port internal aplikasi
PORT=3000

# Domain utama. Aplikasi di BASE_DOMAIN, website user di <username>.BASE_DOMAIN
# Development: localhost  ->  http://localhost:3000 dan http://budi.localhost:3000
BASE_DOMAIN=localhost
PROTOCOL=http

# Production:
# BASE_DOMAIN=rakit.icu
# PROTOCOL=https
# PUBLIC_PORT=
# NODE_ENV=production

# Lokasi database & file user
DATA_DIR=./data

# ---- AI ----
# Endpoint yang kompatibel dengan OpenAI chat completions. Kosongkan untuk menonaktifkan AI.
AI_BASE_URL=https://api.kelontongai.id/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-pro
AI_MAX_TOKENS=64000
# Kredit gratis per user per bulan (reset tiap tanggal 1, UTC), dan biaya per prompt.
AI_MONTHLY_CREDITS=30
AI_CREDITS_PER_PROMPT=1

# ---- Pembayaran (Kasera Pay, QRIS) ----
# API key dari dashboard Kasera → Developer. kp_test_... untuk uji coba, kp_live_... untuk produksi.
KASERA_API_KEY=
# Signing secret endpoint webhook. URL webhook: https://rakit.icu/api/billing/webhook
KASERA_WEBHOOK_SECRET=
# Paket isi ulang: "kredit:harga_rupiah", dipisah koma.
CREDIT_PACKAGES=20:10000,50:20000,150:50000

# ---- Dashboard pemilik ----
# Email akun rakit.icu yang boleh membuka https://rakit.icu/admin (dipisah koma).
ADMIN_EMAILS=
