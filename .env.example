# Port internal aplikasi
PORT=3000

# Domain utama. Aplikasi di BASE_DOMAIN, website user di <username>.BASE_DOMAIN
# Development: localhost  ->  http://localhost:3000 dan http://budi.localhost:3000
BASE_DOMAIN=localhost
PROTOCOL=http

# Production:
# BASE_DOMAIN=rakit.io
# PROTOCOL=https
# PUBLIC_PORT=
# NODE_ENV=production

# Lokasi database & file user
DATA_DIR=./data

# ---- AI ----
# Provider bawaan: endpoint yang kompatibel dengan OpenAI chat completions. Provider lain (OpenAI, Anthropic,
# Gemini, OpenRouter, …) bisa ditambahkan owner di dashboard (/admin → Provider AI). Kosongkan bila tidak dipakai.
AI_BASE_URL=https://api.kelontongai.id/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-pro
# Model cadangan: dipakai otomatis bila AI_MODEL gangguan. Kosong = tanpa cadangan.
# Model utama/cadangan (juga model gambar) bisa diubah owner di dashboard (/admin → Model AI editor);
# setelah disimpan di sana, nilai dashboard yang dipakai.
AI_FALLBACK_MODEL=
AI_MAX_TOKENS=64000
# Jendela konteks model (token), untuk indikator persen konteks di kotak prompt editor
AI_CONTEXT_WINDOW=128000
# Antrean AI: panggilan bersamaan ke provider (turun otomatis bila provider menolak 429/503),
# panjang antrean maksimal, dan batas waktu menunggu (detik).
AI_MAX_CONCURRENT=4
AI_QUEUE_MAX=30
AI_QUEUE_TIMEOUT_S=120
# Default prompt AI gratis per akun per hari (reset 00.00 WIB, tidak menumpuk; prompt bergambar juga dihitung 1).
# Setelah owner menyimpan nilai di dashboard (/admin), nilai dashboard yang dipakai.
AI_DAILY_PROMPTS=20
# Kredit yang dibeli terpakai per prompt setelah jatah harian habis.
AI_CREDITS_PER_PROMPT=1
# Lampiran gambar di prompt: model yang bisa melihat gambar (vision) mendeskripsikannya, lalu AI_MODEL membangun.
# Kosongkan AI_VISION_MODEL untuk mematikan fitur. Prompt dengan gambar memakai AI_IMAGE_PROMPT_CREDITS kredit.
AI_VISION_MODEL=deepseek-v4.1-flash
AI_VISION_FALLBACK_MODEL=
AI_IMAGE_PROMPT_CREDITS=2
# Prediksi kode saat mengetik di editor (gratis, tanpa kredit). Kosongkan AI_COMPLETE_MODEL = pakai model gambar.
# AI_COMPLETE_DAILY_LIMIT = permintaan per akun per hari; 0 mematikan fitur.
AI_COMPLETE_MODEL=
AI_COMPLETE_DAILY_LIMIT=500
# Baca Alur Kode: AI menjelaskan alur satu file langkah demi langkah (gratis, tanpa kredit).
# AI_EXPLAIN_DAILY_LIMIT = permintaan per akun per hari (termasuk tanya lanjutan); 0 mematikan fitur.
AI_EXPLAIN_DAILY_LIMIT=30
# Tool uji Builder (tiruan cara agen menguji hasilnya, tanpa container): test_api (request ke /api/db & /api/fn
# salinan kerja), search_files, dan check_page (buka halaman di Chromium headless bersama, layar HP). 0 = mati.
AI_BUILDER_TESTS=1
# Browser check_page: kosong = cari otomatis (headless shell Playwright: `npx playwright install chromium-headless-shell`,
# lalu chromium/google-chrome); "off" = check_page mati. Tab yang terbuka bersamaan ±50–150 MB masing-masing; browser
# dimatikan sendiri setelah 3 menit menganggur. AI_BROWSER_NO_SANDBOX=1 bila rakit berjalan sebagai root.
AI_BROWSER=
AI_BROWSER_MAX_CONCURRENT=2
AI_BROWSER_NO_SANDBOX=
# Mode Agen di editor: Claude Agent SDK mengerjakan prompt di container Docker (1 kredit, sama dengan Builder):
# AI_AGENT_ENGINES=claude. Bangun image dulu: deploy/agent/build.sh.
# Kosong = mode Agen tidak tampil.
AI_AGENT_ENGINES=
# Batas token (input+output) per prompt; lewat batas, agen dihentikan dan hasil sejauh itu dipakai.
AI_AGENT_MAX_TOKENS=1500000
AI_AGENT_TIMEOUT_S=900
# Container agen yang berjalan bersamaan (masing-masing ±1–1,5 GB RAM karena Chromium); sisanya menunggu giliran.
AI_AGENT_MAX_CONCURRENT=2
AI_AGENT_MEMORY=1536m
AI_AGENT_CPUS=1
# unix (server Linux: container tanpa jaringan, layanan lewat unix socket) | tcp (Docker Desktop untuk pengembangan).
AI_AGENT_TRANSPORT=unix

# ---- Pembayaran (Kasera Pay, QRIS) ----
# API key dari dashboard Kasera → Developer. kp_test_... untuk uji coba, kp_live_... untuk produksi.
KASERA_API_KEY=
# Signing secret endpoint webhook. URL webhook: https://rakit.io/api/billing/webhook
KASERA_WEBHOOK_SECRET=
# Paket isi ulang: "kredit:harga_rupiah", dipisah koma.
CREDIT_PACKAGES=20:10000,50:20000,150:50000

# ---- Asisten AI untuk website pengguna ----
# Paket isi ulang Saldo Asisten (Rupiah), dipisah koma. Model, harga, margin, dan saldo percobaan
# diatur di dashboard owner (/admin → Asisten AI website). Memakai AI_BASE_URL & AI_API_KEY di atas.
ASSISTANT_PACKAGES=10000,25000,50000

# ---- Dashboard pemilik ----
# Email akun rakit.io yang boleh membuka https://rakit.io/admin (dipisah koma).
ADMIN_EMAILS=

# ---- Login dengan Google ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: https://rakit.io/auth/google/callback  (lokal: http://localhost:3000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Project ----
# Jumlah project (subdomain) maksimal per akun.
MAX_PROJECTS=20
# Dari project itu, berapa yang boleh memakai alamat pilihan sendiri (sisanya beralamat acak).
MAX_CUSTOM_DOMAINS=5

# Website publik dikirim dengan .html/.css/.js versi minify (file di editor, versi dev & preview tetap asli).
# Isi 0 untuk mematikan. Hanya di server Go.
# SITE_MINIFY=1
